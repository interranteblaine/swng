{
  "name": "@swng/infra-cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cdk": "cdk",
    "synth": "cdk synth --profile swng",
    "deploy:beta": "cdk deploy swng-beta --profile swng --require-approval never --outputs-file cdk-outputs.json"
  },
  "dependencies": {
    "aws-cdk-lib": "2.262.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@swng/adapters-dynamodb": "workspace:*",
    "@swng/brand": "workspace:*",
    "@swng/lambda": "workspace:*",
    "@types/node": "catalog:",
    "aws-cdk": "2.1133.0",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
