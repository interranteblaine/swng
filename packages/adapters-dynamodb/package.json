{
  "name": "@swng/adapters-dynamodb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:contract": "DYNAMO_CONTRACT=1 vitest run src/contract"
  },
  "dependencies": {
    "@swng/domain": "workspace:*",
    "@swng/application": "workspace:*",
    "@swng/contracts": "workspace:*",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "fast-check": "catalog:",
    "@types/node": "catalog:"
  }
}
